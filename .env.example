# Copy to .env.local. Every value is optional: with none set, the app runs on
# recorded fixtures and a development auth secret.

# Your Cardog API key (https://cardog.app/account/api). Server-side only; it
# never reaches the browser. Leave empty for fixture mode.
CARDOG_API_KEY=

# Any long random string, for signing sessions. Required outside development.
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Where the app is served. Needed when it is not http://localhost:3029.
BETTER_AUTH_URL=http://localhost:3029

# SQLite file. Created on first run.
DATABASE_PATH=data/counter.db

# The seeded review logins are listed in README.md.
